# Copy these variable names into Vercel Project Settings > Environment Variables.
# Replace every placeholder with the matching value from your local .env.local.
NEXT_PUBLIC_SITE_URL=https://your-vercel-domain.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=use-a-strong-admin-password
ADMIN_SECRET_KEY=use-a-long-random-admin-token

# Optional integrations
MEMBERSHIP_NOTIFICATION_EMAIL=
RESEND_API_KEY=
PAYMENT_PROVIDER_KEY=
PAYMENT_WEBHOOK_SECRET=
